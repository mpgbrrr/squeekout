{
  "name": "squeek-chicken",
  "private": true,
  "version": "0.1.0",
  "description": "Squeek Out: ride Squeektoshi's wheel on Squeekchain and bail before he stops.",
  "scripts": {
    "compile": "hardhat compile && node scripts/export-abi.js",
    "test": "hardhat test && node --test test/rules.test.mjs test/payouts.test.mjs test/push.test.mjs test/scheduled-exits.test.mjs",
    "watcher": "node watcher/watcher.mjs",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "game:sepolia": "hardhat run scripts/create-game.js --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "5.1.0",
    "@openzeppelin/hardhat-upgrades": "3.9.1",
    "hardhat": "^2.28.6"
  },
  "dependencies": {
    "viem": "^2.21.55",
    "web-push": "3.6.7"
  }
}
